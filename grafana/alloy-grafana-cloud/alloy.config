// alloy.config — Grafana Alloy configuration for Grafana Cloud + Elasticsearch
// Deploy this via Grafana Cloud Fleet Management → Remote Configuration → Editor.
// Replace all <PLACEHOLDER> values before publishing.

// ---------------------------------------------------------------------------
// Scrape — Node Exporter (host-level OS metrics)
// ---------------------------------------------------------------------------
prometheus.scrape "node_exporter" {
  targets = [{"__address__" = "localhost:9100"}]
  forward_to = [prometheus.relabel.integrations_node_exporter.receiver]
  scrape_interval = "15s"
}

// ---------------------------------------------------------------------------
// Relabel — filter which metrics are forwarded downstream
// ---------------------------------------------------------------------------
// Adjust the regex to expand or restrict the metric set shipped to both
// Grafana Cloud and Elasticsearch.
prometheus.relabel "integrations_node_exporter" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "up|node_arp_entries|node_boot_time_seconds|node_context_switches_total|node_cpu_seconds_total|node_disk_io_time_seconds_total|node_disk_read_bytes_total|node_disk_written_bytes_total|node_filesystem_avail_bytes|node_filesystem_size_bytes|node_load1|node_load15|node_load5|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_MemTotal_bytes|node_network_receive_bytes_total|node_network_transmit_bytes_total|node_os_info"
    action        = "keep"
  }
}

// ---------------------------------------------------------------------------
// Remote Write — Grafana Cloud Metrics + Elasticsearch (dual fan-out)
// ---------------------------------------------------------------------------
// Both endpoints receive the same filtered metrics simultaneously.
// Update the Grafana Cloud endpoint URL to match your stack's region.
prometheus.remote_write "metrics_service" {

  // --- Grafana Cloud Metrics (Mimir) ---
  endpoint {
    url = "https://prometheus-prod-12-prod-us-west-0.grafana.net/api/prom/push"
    // Find your endpoint: Grafana Cloud Portal → your stack → Prometheus → Remote Write endpoint

    basic_auth {
      username = "<YOUR_GRAFANA_CLOUD_INSTANCE_ID>"
      // Generate a token: Grafana Cloud Portal → Access Policies → create with metrics:write scope
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }

  // --- Elasticsearch (ECH or Serverless) ---
  // Alloy uses the headers block for auth here (not the authorization block used in standalone Prometheus)
  endpoint {
    url = "https://<YOUR_ES_ENDPOINT>/_prometheus/api/v1/write"
    // ECH:        https://<cluster-id>.es.<region>.aws.elastic-cloud.com/_prometheus/api/v1/write
    // Serverless: https://<project-id>.es.<region>.aws.elastic.co/_prometheus/api/v1/write

    headers = {
      "Authorization" = "ApiKey <YOUR_BASE64_API_KEY>",
    }
  }
}
